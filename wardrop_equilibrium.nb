Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"createTransportGraph", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "Oi", ",", "Di", ",", "intermediates", ",", 
       "usedIntermediates", ",", "vertices", ",", 
       RowBox[{"P", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"t", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "tNew", ",", "G", 
       ",", "addEdge", ",", "lenPath", ",", "path", ",", "paths", ",", 
       "extraEdges", ",", "u", ",", "v", ",", "perm"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Oi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\"\<O\>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Di", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\"\<D\>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intermediates", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\"", ",", "\"\<E\>\""}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"usedIntermediates", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{"intermediates", ",", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", 
            RowBox[{"Length", "[", "intermediates", "]"}]}], "}"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vertices", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"Oi", ",", "usedIntermediates", ",", "Di"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"addEdge", "[", 
        RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "ti"}], "}"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"P", ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "v"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"a", "=", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ";", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"a", "==", "0"}], ",", 
            RowBox[{"a", "=", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"b", "=", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ti", "=", 
           RowBox[{"Function", "[", 
            RowBox[{"y", ",", 
             RowBox[{
              RowBox[{"a", "*", "y"}], "+", "b"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"t", ",", "ti"}], "]"}], ";"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"lenPath", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", "4"}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"path", "=", 
          RowBox[{"RandomSample", "[", 
           RowBox[{"usedIntermediates", ",", 
            RowBox[{"lenPath", "-", "2"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"paths", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Oi", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", "path", ",", 
            RowBox[{"{", 
             RowBox[{"Di", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"addEdge", "[", 
            RowBox[{
             RowBox[{"paths", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{"paths", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"Length", "[", "paths", "]"}], "-", "1"}]}], "}"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"extraEdges", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u", ",", "v"}], "}"}], "=", 
          RowBox[{"RandomSample", "[", 
           RowBox[{"vertices", ",", "2"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"P", ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"addEdge", "[", 
            RowBox[{"u", ",", "v"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", "extraEdges", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"perm", "=", 
       RowBox[{"RandomSample", "[", "vertices", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"P", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"perm", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"perm", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
          ",", 
          RowBox[{"addEdge", "[", 
           RowBox[{
            RowBox[{"perm", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"perm", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{
           RowBox[{"Length", "[", "perm", "]"}], "-", "1"}]}], "}"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"tNew", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"t", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "[", "y", "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "t", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"G", "=", 
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"DirectedEdge", "@@@", "P"}], ",", 
         RowBox[{"EdgeWeight", "->", "tNew"}], ",", 
         RowBox[{"EdgeLabels", "->", "\"\<EdgeWeight\>\""}], ",", 
         RowBox[{"VertexLabels", "->", "\"\<Name\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Graph\>\"", "->", "G"}], ",", 
        RowBox[{"\"\<Vertices\>\"", "->", "vertices"}], ",", 
        RowBox[{"\"\<Edges\>\"", "->", "P"}], ",", 
        RowBox[{"\"\<CostFunctions\>\"", "->", "t"}]}], "|>"}]}]}], "]"}]}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.955628804872134*^9, 3.955628805349256*^9}, 
   3.955636308077572*^9, {3.9557244442844687`*^9, 3.9557244625712447`*^9}, {
