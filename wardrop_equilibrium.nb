Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"optimizeTransportFlow", "[", 
    RowBox[{
    "graph_", ",", "O\[Gamma]_", ",", "D\[Gamma]_", ",", "t_", ",", 
     "edges_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Ui", ",", "checkEd", ",", "c", ",", "generalflow", ",", "X", ",", 
       "x\[Alpha]", ",", "fi", ",", "F"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ui", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"FindPath", "[", 
            RowBox[{"graph", ",", 
             RowBox[{"O\[Gamma]", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"D\[Gamma]", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", "Infinity", ",", "All"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "@", "O\[Gamma]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "@", "D\[Gamma]"}]}], "}"}]}], "]"}], ",", 
         "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"checkEd", "[", "e_", "]"}], ":=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{"Ui", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "2", ",", "1"}], "]"}], 
             ",", "e"}], "]"}], ",", "1", ",", "0"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "@", "Ui"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"checkEd", "/@", "edges"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"X", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Symbol", "[", 
           RowBox[{"\"\<x\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "@", 
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"x\[Alpha]", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
            RowBox[{"X", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "X", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "edges", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"f", "=", 
             RowBox[{"t", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"Function", "[", 
            RowBox[{"y", ",", 
             RowBox[{"Integrate", "[", 
              RowBox[{
               RowBox[{"f", "[", "x", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", "y"}], "}"}]}], "]"}]}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "t", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"F", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", "#2", "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"fi", ",", "x\[Alpha]"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "F"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9556288626432557`*^9, 3.9556288631738253`*^9}, 
