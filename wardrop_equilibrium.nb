Cell[BoxData[
 RowBox[{
  RowBox[{"addZeroBridges", "[", "graph_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"vertices", "=", 
       RowBox[{"graph", "[", "\"\<Vertices\>\"", "]"}]}], ",", 
      RowBox[{"P", "=", 
       RowBox[{"graph", "[", "\"\<Edges\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"graph", "[", "\"\<CostFunctions\>\"", "]"}]}], ",", 
      "intermediates", ",", "newP", ",", "t\[Alpha]", ",", "newG", ",", 
      "tNew", ",", "bridges", ",", "u", ",", "v"}], "}"}], ",", 
    RowBox[{
     RowBox[{"intermediates", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"vertices", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"StringMatchQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{"LetterCharacter", "~~", "___"}]}], "]"}], "&&", 
          RowBox[{"!", 
           RowBox[{"StringStartsQ", "[", 
            RowBox[{"#", ",", "\"\<O\>\""}], "]"}]}], "&&", 
          RowBox[{"!", 
           RowBox[{"StringStartsQ", "[", 
            RowBox[{"#", ",", "\"\<D\>\""}], "]"}]}]}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"newP", "=", "P"}], ";", "\[IndentingNewLine]", 
     RowBox[{"t\[Alpha]", "=", "t"}], ";", "\[IndentingNewLine]", 
     RowBox[{"bridges", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"intermediates", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"v", "=", 
         RowBox[{"intermediates", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "j"}], "&&", 
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"newP", ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", "v"}], "}"}]}], "]"}]}], "&&", 
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"newP", ",", 
              RowBox[{"{", 
               RowBox[{"v", ",", "u"}], "}"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"newP", ",", 
             RowBox[{"{", 
              RowBox[{"u", ",", "v"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"t\[Alpha]", ",", 
             RowBox[{"Function", "[", 
              RowBox[{"y", ",", "0"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"bridges", ",", 
             RowBox[{"{", 
