Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CompareFlowEfficiency", "[", 
    RowBox[{"minNM1_", ",", "minNM2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val1", ",", "val2", ",", "hasSolution1", ",", "hasSolution2"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hasSolution1", "=", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{"minNM1", ",", 
          RowBox[{"$Failed", "|", 
           RowBox[{"{", 
            RowBox[{"_", ",", 
             RowBox[{"{", "__Indeterminate", "}"}]}], "}"}], "|", 
           RowBox[{"{", 
            RowBox[{"_", ",", 
             RowBox[{"{", 
              RowBox[{"_DirectedInfinity", ",", "__"}], "}"}]}], "}"}]}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"hasSolution2", "=", 
       RowBox[{"!", 
        RowBox[{"MatchQ", "[", 
         RowBox[{"minNM2", ",", 
          RowBox[{"$Failed", "|", 
           RowBox[{"{", 
            RowBox[{"_", ",", 
             RowBox[{"{", "__Indeterminate", "}"}]}], "}"}], "|", 
           RowBox[{"{", 
            RowBox[{"_", ",", 
             RowBox[{"{", 
              RowBox[{"_DirectedInfinity", ",", "__"}], "}"}]}], "}"}]}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", "hasSolution1"}], "&&", 
         RowBox[{"!", "hasSolution2"}]}], ",", 
